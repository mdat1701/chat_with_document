# Sao chép thành .env trước khi chạy `make up`. KHÔNG commit .env thật
# (đã có trong .gitignore). Giá trị mật khẩu ở đây chỉ dùng cho local.

# --- Hạ tầng (T-002) ------------------------------------------------
POSTGRES_DB=cwd
POSTGRES_USER=cwd
POSTGRES_PASSWORD=cwd_local_only
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=cwd_minio
MINIO_ROOT_PASSWORD=cwd_minio_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

CLAMAV_PORT=3310
TEI_PORT=8080

# --- Back-end app (đọc bởi backend/app/core/config.py) --------------
DATABASE_URL=postgresql+asyncpg://cwd:cwd_local_only@localhost:5432/cwd
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=cwd_minio
S3_SECRET_KEY=cwd_minio_local_only
S3_BUCKET=cwd-documents

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

TEI_EMBED_URL=http://localhost:8080

# --- Giá trị mặc định DF-01 – DF-10 (PRD §0.3) — expose qua GET /config, T-105
MAX_FILE_SIZE_BYTES=20971520
MAX_DOCUMENTS=50
MAX_PAGES=300
RETENTION_DAYS=90
MAX_QUESTION_LENGTH=2000
ANSWER_TIMEOUT_MS=60000

# --- OIDC (T-101, chờ D-03) ------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- LLM (T-301, chờ D-01) --------------------------------------------
LLM_PROVIDER=fake
